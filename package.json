{
	"name": "weighted-shuffle",
	"description": "Non-mutating weighted random shuffle for arrays and objects",
	"version": "1.0.0",
	"license": "Apache-2.0",
	"type": "commonjs",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"bugs": "https://github.com/denizdogan/weighted-shuffle/issues",
	"homepage": "https://github.com/denizdogan/weighted-shuffle",
	"repository": {
		"type": "git",
		"url": "https://github.com/denizdogan/weighted-shuffle.git"
	},
	"files": [
		"/dist"
	],
	"keywords": [
		"shuffle",
		"weighted",
		"weighted-shuffle",
		"random",
		"random-shuffle",
		"weighted-random",
		"sampling",
		"weighted-random-sampling",
		"sampling-without-replacement",
		"random-permutation",
		"randomization",
		"probability",
		"non-mutating",
		"typescript"
	],
	"scripts": {
		"build": "vite build",
		"watch": "vite build --watch",
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"typecheck": "tsc",
		"test": "npm run typecheck && vitest run",
		"test:watch": "vitest",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^5.0.5",
		"husky": "^1.3.1",
		"lint-staged": "^13.1.0",
		"rolldown-plugin-dts": "^0.28.8",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"lint-staged": {
		"*.{ts,js,mts,cts,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched"
	}
}
